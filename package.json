{
    "name": "portafolio",
    "private": true,
    "version": "3.0.0",
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "build:analyze": "vite build --mode analyze",
        "preview": "vite preview",
        "predeploy": "npm run build",
        "deploy": "gh-pages -d dist",
        "analyze": "npm run build:analyze && source-map-explorer \"dist/assets/*.js\" --no-border-checks --gzip",
        "format": "prettier --write \"src/**/*.{js,jsx,json,css,scss,md}\"",
        "format:check": "prettier --check \"src/**/*.{js,jsx,json,css,scss,md}\"",
        "lint": "eslint --fix src",
        "tokens:sync": "node scripts/generate-scss-tokens.mjs",
        "lint:check": "eslint src"
    },
    "dependencies": {
        "@heroui/button": "2.2.28",
        "@heroui/code": "2.2.22",
        "@heroui/dropdown": "2.3.28",
        "@heroui/input": "2.4.29",
        "@heroui/kbd": "2.2.23",
        "@heroui/link": "2.2.24",
        "@heroui/navbar": "2.2.26",
        "@heroui/react": "2.8.6",
        "@heroui/snippet": "2.2.29",
        "@heroui/switch": "2.2.25",
        "@heroui/system": "2.4.24",
        "@heroui/theme": "2.4.24",
        "@heroui/use-theme": "2.1.10",
        "@react-types/shared": "3.32.1",
        "@rollup/plugin-image": "^3.0.3",
        "@tailwindcss/postcss": "^4.1.18",
        "@tailwindcss/vite": "^4.1.18",
        "autoprefixer": "10.4.23",
        "clsx": "2.1.1",
        "framer-motion": "12.23.26",
        "lucide-react": "0.562.0",
        "react": "18.3.1",
        "react-dom": "18.3.1",
        "react-helmet-async": "^2.0.5",
        "react-hot-toast": "^2.6.0",
        "react-lazy-load-image-component": "1.6.3",
        "react-router-dom": "^7.12.0",
        "react-router-hash-link": "^2.4.3",
        "sass": "1.97.0",
        "source-map-explorer": "^2.5.3",
        "swiper": "^12.0.3",
        "tailwind-variants": "3.2.2",
        "tailwindcss": "^4.1.18",
        "vite-plugin-pwa": "1.2.0"
    },
    "devDependencies": {
        "@types/react": "18.3.3",
        "@types/react-dom": "18.3.0",
        "@vitejs/plugin-react": "5.1.2",
        "eslint": "9.39.2",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.4",
        "eslint-plugin-react": "7.37.5",
        "eslint-plugin-react-hooks": "7.0.1",
        "eslint-plugin-react-refresh": "0.4.26",
        "gh-pages": "6.3.0",
        "postcss": "8.5.6",
        "prettier": "^3.7.4",
        "vite": "7.3.0"
    }
}
